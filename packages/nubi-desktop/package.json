{
  "name": "nubi-desktop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <26"
  },
  "workspaces": [
    "extension",
    "browser-app",
    "electron-app",
    "vendor/decompress-compat"
  ],
  "scripts": {
    "build": "npm run compile && npm run bundle --workspace=@nubi/browser-app && node scripts/copy-assets.mjs browser-app",
    "compile": "node scripts/build-runtime.mjs && tsc -p extension",
    "start": "node scripts/start.mjs browser-app",
    "build:electron": "npm run compile && npm run bundle --workspace=@nubi/electron-app && node scripts/copy-assets.mjs electron-app",
    "start:electron": "node scripts/start.mjs electron-app",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/check-ui.mjs",
    "test:shared-ui": "node scripts/check-shared-ui.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "test:electron": "node scripts/check-electron.mjs"
  },
  "devDependencies": {
    "@theia/cli": "1.75.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.12",
    "serialize-javascript": "7.0.5",
    "electron-builder": "26.15.3",
    "react-tooltip": "4.5.1",
    "trash": "7.2.0",
    "@theia/monaco-editor-core": "1.108.201"
  },
  "dependencies": {
    "@e2e/cx-design-system": "file:../../extensions/aipro-chat/vendor/e2e-cx-design-system-0.5.4.tgz",
    "@earendil-works/pi-agent-core": "0.86.1",
    "@earendil-works/pi-ai": "0.86.1",
    "@vscode/ripgrep": "1.18.0",
    "ajv": "8.20.0",
    "diff": "9.0.0",
    "graphology": "0.26.0",
    "is-network-error": "1.3.2",
    "jsonc-parser": "3.3.1",
    "knex": "3.3.0",
    "knex-schema-inspector": "3.1.0",
    "lowlight": "3.3.0",
    "minisearch": "7.2.0",
    "mysql2": "3.24.4",
    "node-sql-parser": "5.4.0",
    "oracledb": "7.0.1",
    "p-retry": "8.0.1",
    "pg": "8.23.0",
    "pixelmatch": "7.1.0",
    "playwright": "1.58.2",
    "pngjs": "7.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tedious": "20.0.0",
    "typescript": "5.9.3",
    "yaml": "2.9.0",
    "dompurify": "3.4.15"
  },
  "overrides": {
    "decompress": "file:./vendor/decompress-compat",
    "serialize-javascript": "7.0.5",
    "dompurify": "$dompurify",
    "react-tooltip": {
      "uuid": "11.1.1"
    },
    "trash": {
      "uuid": "11.1.1"
    },
    "mocha": {
      "diff": "8.0.3"
    }
  }
}
