{
  "name": "nubi-desktop",
  "version": "1.1.2",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <26"
  },
  "workspaces": [
    "electron-app"
  ],
  "scripts": {
    "build": "npm run build:electron",
    "compile": "node scripts/build-runtime.mjs",
    "start": "node scripts/start.mjs",
    "build:electron": "npm run compile && node scripts/build-electron.mjs",
    "start:electron": "node scripts/start.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:ui": "node scripts/check-electron-shell.mjs",
    "test:lifecycle": "node scripts/check-electron-lifecycle.mjs",
    "test:gates": "npm test && npm run design:check && npm run test:forms-ui && npm run test:mail-ui && npm run test:modals-ui && npm run test:shared-ui && npm run build:electron && npm run test:ui && npm run test:skills-ui && npm run test:agent-ui && npm run test:live-web && npm run test:lifecycle && npm run test:all-surfaces",
    "test:shared-ui": "node scripts/check-shared-ui.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "test:electron": "node scripts/check-electron-shell.mjs",
    "design:check": "node scripts/check-identity.mjs",
    "verify:identity": "npm run build && npm run test:ui && npm run test:skills-ui && npm run test:shared-ui && npm run test:forms-ui && npm run test:mail-ui && npm run test:modals-ui",
    "test:forms-ui": "node scripts/check-form-clarity.mjs",
    "test:mail-ui": "node scripts/check-mail-ui.mjs",
    "test:modals-ui": "node scripts/check-modals.mjs",
    "start:web": "node scripts/start-web.mjs",
    "preview:web": "node scripts/start-web.mjs",
    "preview:mock": "node scripts/preview-web.mjs",
    "test:skills-ui": "node scripts/check-electron-skills.mjs",
    "test:live-web": "node scripts/check-live-web.mjs",
    "test:agent-ui": "node scripts/check-electron-agent.mjs",
    "test:all-surfaces": "node scripts/check-all-surfaces.mjs"
  },
