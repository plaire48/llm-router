{
  "name": "@nubi/browser-app",
  "version": "1.1.0",
  "private": true,
  "dependencies": {
    "@theia/core": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/markers": "1.75.0",
    "@theia/messages": "1.75.0",
    "@theia/monaco": "1.75.0",
    "@theia/navigator": "1.75.0",
    "@theia/preferences": "1.75.0",
    "@theia/process": "1.75.0",
    "@theia/terminal": "1.75.0",
    "@theia/workspace": "1.75.0",
    "@theia/search-in-workspace": "1.75.0",
    "@theia/scm": "1.75.0",
    "@nubi/theia-extension": "1.1.0"
  },
  "devDependencies": {
    "@theia/cli": "1.75.0"
  },
  "scripts": {
    "bundle": "theia build --mode development",
    "start": "theia start --hostname=127.0.0.1 --port=4330"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "누비 workspace beta 1.1.0",
        "defaultTheme": "light",
        "defaultIconTheme": "theia-file-icons",
        "preferences": {
          "editor.fontSize": 14,
          "files.autoSave": "off",
          "workbench.colorTheme": "light"
        },
        "electron": {
          "windowOptions": {
            "width": 1480,
            "height": 960
          },
          "appUserModelId": "nubi.workspace"
        }
      }
    }
  }
}
