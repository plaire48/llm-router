{
  "id": "expense-draft",
  "title": "경비 신청 양식(규정 적용 전)",
  "window": {
    "hwnd": 4100,
    "processId": 8200,
    "processName": "ExpenseForm",
    "title": "경비 신청 - 작성 중",
    "dpi": 96,
    "width": 900,
    "height": 860
  },
  "controls": [
    {
      "selector": "txt-applicant",
      "name": "신청자",
      "type": "Edit",
      "value": "김민수"
    },
    {
      "selector": "cmb-department",
      "name": "부서",
      "type": "ComboBox",
      "value": "영업팀",
      "expansion": "Collapsed",
      "children": [
        {
          "selector": "item-dept-sales",
          "name": "영업팀",
          "type": "ListItem",
          "selected": "True"
        },
        {
          "selector": "item-dept-dev",
          "name": "개발팀",
          "type": "ListItem",
          "selected": "False"
        },
        {
          "selector": "item-dept-ops",
          "name": "운영팀",
          "type": "ListItem",
          "selected": "False"
        }
      ]
    },
    {
      "selector": "txt-amount",
      "name": "금액(원)",
      "type": "Edit",
      "value": "30000"
    },
    {
      "selector": "txt-date",
      "name": "사용일",
      "type": "Edit",
      "value": "2026-09-21"
    },
    {
      "selector": "chk-receipt",
      "name": "영수증 첨부",
      "type": "CheckBox",
      "toggle": "Off"
    },
    {
      "selector": "chk-urgent",
      "name": "긴급 처리",
      "type": "CheckBox",
      "toggle": "On"
    },
    {
      "selector": "txt-memo",
      "name": "메모",
      "type": "Edit",
      "value": ""
    },
    {
      "selector": "txt-approval-password",
      "name": "결재 비밀번호",
      "type": "Edit",
      "value": "p@ss-7731",
      "password": true
    },
    {
      "selector": "txt-document-number",
      "name": "문서 번호",
      "type": "Edit",
      "value": "EXP-2026-0917",
      "readOnly": true
    },
    {
      "selector": "grp-actions",
      "name": "작업",
      "type": "Group",
      "children": [
        {
          "selector": "btn-save",
          "name": "임시 저장",
          "type": "Button"
        },
        {
          "selector": "btn-submit",
          "name": "제출",
          "type": "Button"
        },
        {
          "selector": "btn-delete",
          "name": "삭제",
          "type": "Button"
        }
      ]
    },
    {
      "selector": "grp-detail",
      "name": "상세",
      "type": "Group",
      "children": [
        {
          "selector": "grp-detail-1",
          "name": "정산",
          "type": "Group",
          "children": [
            {
              "selector": "grp-detail-2",
              "name": "계좌",
              "type": "Group",
              "children": [
                {
                  "selector": "grp-detail-3",
                  "name": "입금",
                  "type": "Group",
                  "children": [
                    {
                      "selector": "grp-detail-4",
                      "name": "은행",
                      "type": "Group",
                      "children": [
                        {
                          "selector": "txt-bank-account",
                          "name": "입금 계좌 끝 4자리",
                          "type": "Edit",
                          "value": "4821",
                          "offscreen": true
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "selector": "lbl-status",
      "name": "상태: 작성 중",
      "type": "Text"
    }
  ],
  "rules": [
    {
      "on": {
        "selector": "btn-save",
        "action": "invoke"
      },
      "set": [
        {
          "selector": "lbl-status",
          "name": "상태: 임시 저장됨"
        }
      ],
      "record": "saved"
    },
    {
      "on": {
        "selector": "btn-submit",
        "action": "invoke"
      },
      "when": {
        "txt-amount": "^[1-9][0-9]*$"
      },
      "set": [
        {
          "selector": "lbl-status",
          "name": "상태: 제출됨"
        }
      ],
      "record": "submitted"
    },
    {
      "on": {
        "selector": "btn-submit",
        "action": "invoke"
      },
      "set": [
        {
          "selector": "lbl-status",
          "name": "상태: 금액을 숫자로 입력하세요"
        }
      ],
      "record": "submit_refused"
    },
    {
      "on": {
        "selector": "btn-delete",
        "action": "invoke"
      },
      "set": [
        {
          "selector": "lbl-status",
          "name": "상태: 삭제됨"
        }
      ],
      "record": "deleted"
    }
  ]
}
