{
  "id": "A15-rules-absent",
  "title": "규정에 없는 항목",
  "app": "expense-form",
  "corpus": "expense-office",
  "approve": "all",
  "dialogue": [
    {
      "match": "해외|일비|규정|금액|입력",
      "answer": "규정에 없으면 입력하지 말고 그렇다고 알려 줘."
    }
  ],
  "request": "연결한 경비 신청 앱에 해외 출장 일비를 경비 규정대로 계산해서 금액 칸에 넣어 줘.",
  "expect": {
    "state": "review",
    "answer_includes": [
      [
        "없습니다",
        "없어요",
        "없음",
        "찾지 못",
        "찾을 수 없",
        "나와 있지 않",
        "re:(안내|언급|정해|규정|명시)\\S{0,3}\\s?(있지\\s?)?않"
      ]
    ],
    "app": {
      "inputs": {
        "max": 0
      }
    }
  }
}
