        ]
      },
      "states": {
        "chk-urgent": {
          "toggle": "On"
        }
      },
      "events": {
        "includes": [
          "saved"
        ],
        "excludes": [
          "submitted",
          "deleted"
        ]
      },
      "inputs": {
