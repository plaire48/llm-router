{
  "name": "@nubi/electron-app",
  "version": "1.1.0",
  "private": true,
  "dependencies": {
    "@nubi/theia-extension": "1.1.0",
    "@theia/core": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/electron": "1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/markers": "1.75.0",
    "@theia/messages": "1.75.0",
    "@theia/monaco": "1.75.0",
    "@theia/navigator": "1.75.0",
    "@theia/preferences": "1.75.0",
    "@theia/process": "1.75.0",
    "@theia/scm": "1.75.0",
    "@theia/search-in-workspace": "1.75.0",
    "@theia/terminal": "1.75.0",
    "@theia/workspace": "1.75.0",
    "@vscode/ripgrep": "1.18.0",
    "@earendil-works/pi-agent-core": "0.86.1",
    "@earendil-works/pi-ai": "0.86.1",
    "knex": "3.3.0",
    "knex-schema-inspector": "3.1.0",
    "playwright": "1.58.2",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "minisearch": "7.2.0",
    "typescript": "5.9.3",
    "jsonc-parser": "3.3.1",
    "mysql2": "3.24.4",
    "oracledb": "7.0.1",
    "pg": "8.23.0",
    "tedious": "20.0.0"
  },
  "devDependencies": {
    "@theia/cli": "1.75.0",
    "electron": "42.8.1"
  },
  "scripts": {
    "bundle": "theia build --mode development",
    "start": "theia start --hostname=127.0.0.1 --port=4330"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "누비 workspace beta 1.1.0",
        "defaultTheme": "light",
        "defaultIconTheme": "theia-file-icons",
        "preferences": {
          "editor.fontSize": 14,
          "files.autoSave": "off",
          "workbench.colorTheme": "light"
        },
        "electron": {
          "windowOptions": {
            "width": 1480,
            "height": 960
          },
          "appUserModelId": "nubi.workspace"
        }
      }
    }
  },
  "main": "launcher.cjs",
  "description": "Nubi Workspace beta desktop agent",
  "author": "Nubi"
}
