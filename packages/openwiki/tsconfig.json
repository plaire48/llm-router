{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "allowJs": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/agent/enterprise/*.js"],
  "exclude": ["src/visualize/client.ts"]
}
