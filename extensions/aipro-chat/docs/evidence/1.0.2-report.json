  "regressions": {
    "accessibility": {
      "version": "1.0.2",
      "checks": [
        "360px login logos load locally and settings keep only diagnostics/data retention with keyboard, copy, focus return and reload",
        "1100px login logos load locally and settings keep only diagnostics/data retention with keyboard, copy, focus return and reload",
        "diagnostics retain sanitized copy; header logout returns to provider choices without accessibility warnings"
      ],
      "warnings": [],
      "pageErrors": [],
      "syntheticBrowser": true,
      "realAiProVerified": false,
      "clipboardStubbed": true
    },
    "approval": {
      "checks": [
        "compose, fill and verify a real browser draft without a repeated user request; final registration pauses and detaches debugger",
        "approval and actual draft preview survive chat reload, preserve composer text and fit narrow and wide layouts",
        "wrong conversation, wrong question and replacement credentials cannot reuse a pending approval",
        "approval executes exactly one trusted click, verifies the visible result and rejects replay without clearing composer text",
        "cancel needs no model call, preserves the page draft and revokes the pending approval",
        "unverified final script clicks are refused; the model verifies the draft before an approval can appear",
        "a written revision retains the original goal, updates the draft, revokes the old grant and requests fresh approval",
        "the pencil opens full draft fields; edited values are applied and verified with fresh approval, without final submission",
        "draft edits, iframe edits, replaced controls, same-URL reloads and expired grants all refuse stale approved actions",
        "script clicks are guarded and catching the pause cannot run subsequent writes",
        "visual-only final actions can request explicit screenshot-point approval; moved targets are rejected and unchanged targets execute once"
      ],
      "errors": [],
      "syntheticModelResponses": true,
      "realBrowserActions": true,
      "actualCompanyPageVerified": false
    },
    "captures": {
      "version": "1.0.2",
      "checks": [
        "direct capture and both captures inside a generated script appear during the pending reply",
        "capture contains only the browser viewport, masks password fields and omits URL parameters from metadata",
        "card downloads the original PNG byte-for-byte with a unique filename and started feedback",
        "CX preview supports original-size scrolling, fit, gallery navigation, Escape and focus return at desktop and panel widths",
        "capture attachments survive reload and respect reduced motion",
        "failed download keeps an inline retry and succeeds on the next click",
        "the native Chrome side panel displays, expands and downloads the same PNG successfully",
        "a missing image has an explicit reload action and recovers without changing the reply",
        "storage limits reject new images without silently evicting existing attachments",
        "browser restart retains archived and inactive provider images after reauthentication",
        "new conversation retains images; deleting its history removes only its PNGs without touching other providers"
      ],
      "realBrowserCaptures": true,
      "syntheticQwenResponses": true,
      "liveAiProVerified": false
    },
    "page-skills": {
      "synthetic": true,
      "realAiProVerified": false,
      "permissionScope": "Pregranted fixture writes; simulated user decline; unchanged distribution in a second profile for actual missing-grant injection denial",
      "actualOptionalHostPermission": false,
      "fixtureSiteAccessPregranted": true,
      "userDeclineSimulated": true,
      "actualUngrantedAccessVerified": true,
      "assertions": [
        "five built-in skills and Markdown import/edit persist across reload with icon-only entry points",
        "declining optional access preserves the draft and sends no page or model request",
        "source and structure skills automatically connect the original website after opening full-screen chat without a link click",
        "model-driven inspect and fill proposal make no page changes before review or after cancellation",
        "tool results omit form values, hidden content, scripts, secret inputs and URL query values",
        "edits made after proposal invalidate the whole plan before any field changes",
        "approved fields dispatch input events and report actual changes without submitting; stale plans are rejected",
        "navigation to another document cannot receive an old approved fill plan",
        "browser agent inspects DOM, reads selected site storage, proposes values and verifies the applied DOM; trace survives reload without tool payloads",
        "storage tools enforce prior key listing, secret filtering, nested serialized JSON filtering and bounded results across local/session storage",
        "post-action verification catches a site reverting the field asynchronously and returns failure evidence to the model",
